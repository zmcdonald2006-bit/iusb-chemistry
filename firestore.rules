rules_version = '2';

// Chem Companion database rules.
// - users/{uid}: each signed-in person can read and write only their own progress.
// - feedback/{id}: signed-in people can send "This confused me" reports. Nobody can read, change or
//   delete them from the app; the project owner reads them in the Firebase console.
// Nothing else in the database is reachable.
// Paste this into Firebase → Firestore → (your database) → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function text(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'enc', 'rev', 'schema', 'app', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.rev is int;
    }

    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'who', 'kind', 'note', 'where', 'link', 'item', 'question', 'given', 'answer', 'app', 'ts', 'createdAt'])
        && request.resource.data.kind in ['unclear', 'wrong', 'topic', 'other']
        && request.resource.data.ts is int
        && request.resource.data.createdAt == request.time
        && text(request.resource.data, 'who', 60)
        && text(request.resource.data, 'note', 1000)
        && text(request.resource.data, 'where', 200)
        && text(request.resource.data, 'link', 500)
        && text(request.resource.data, 'item', 200)
        && text(request.resource.data, 'question', 2000)
        && text(request.resource.data, 'given', 500)
        && text(request.resource.data, 'answer', 500)
        && text(request.resource.data, 'app', 40);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
