rules_version = '2';

// Chem Companion: each signed-in person can read and write only their own progress document
// (users/{their Google account's uid}). Nothing else in the database is reachable.
// Paste this into Firebase → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'enc', 'rev', 'schema', 'app', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.rev is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
